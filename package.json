{
  "name": "ocarina-tabs",
  "version": "0.1.0",
  "description": "Translate MIDI, MusicXML, ABC and note text into ocarina fingering tabs (4, 6 and 12 hole).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ocarina-tabs": "dist-cli/ocarina-tabs.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-cli/ocarina-tabs.mjs",
    "preview": "vite preview",
    "ocarina": "tsx src/cli/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
